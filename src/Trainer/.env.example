# Coordinator REST API base URL (HTTP)
COORDINATOR_ADDRESS=http://localhost:5000

# Coordinator Command Service endpoint (gRPC)
COORDINATOR_GRPC_ADDRESS=localhost:5001

# Trainer Node Identifier (logical identifier)
TRAINER_NODE_ID=trainer-node-01

# HTTP and network request timeout in seconds
REQUEST_TIMEOUT_SECONDS=10.0

# Working directory for local trainer artifacts and execution
TRAINER_WORKING_DIRECTORY=/artifacts
