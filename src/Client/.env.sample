# ==============================================================================
# TrainSwarm Client Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your local or production setup:
#   cp .env.sample .env
# ==============================================================================

# Coordinator REST API base URL (Required)
COORDINATOR_ADDRESS=http://localhost:8080

# Unique client node identifier (Optional, defaults to client-node-dev)
CLIENT_NODE_ID=client-node-dev

# HTTP request timeout in seconds (Optional, defaults to 10.0)
REQUEST_TIMEOUT_SECONDS=10.0

# Path to the local SQLite database file (Optional, defaults to ./training.db)
TRAINING_CLIENT_DB_PATH=./training.db

# Root working directory for staged models and dataset shards (Optional, defaults to ./artifacts)
TRAINING_WORKING_DIRECTORY=./artifacts

# Target training duration limit per shard in seconds for smoke test shard sizing (Optional, defaults to 300.0)
SHARD_TRAINING_TIME_LIMIT=300.0

# Safety factor multiplier for shard sizing calculations (0.0 < factor <= 1.0, defaults to 1.0)
SHARD_SAFETY_FACTOR=1.0
