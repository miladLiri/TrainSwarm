{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TinyStoriesTrainingConfig",
  "description": "Validation schema for TinyStories training configuration and causal_decoder_config.json",
  "type": "object",
  "required": [
    "batch_size",
    "gradient_accumulation_steps",
    "learning_rate",
    "weight_decay",
    "seed"
  ],
  "properties": {
    "seed": { "type": "integer", "default": 42 },
    "batch_size": { "type": "integer", "minimum": 1, "default": 16 },
    "epochs": { "type": "integer", "minimum": 1, "default": 1 },
    "max_steps": { "type": ["integer", "null"], "default": null },
    "learning_rate": { "type": "number", "minimum": 0.0, "default": 0.0001 },
    "weight_decay": { "type": "number", "minimum": 0.0, "default": 0.01 },
    "gradient_accumulation_steps": { "type": "integer", "minimum": 1, "default": 2 },
    "max_grad_norm": { "type": "number", "default": 1.0 },
    "scheduler_type": { "type": "string", "default": "linear" },
    "warmup_steps": { "type": "integer", "minimum": 0, "default": 20 },
    "warmup_ratio": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.0 },
    "logging_steps": { "type": "integer", "minimum": 1, "default": 5 },
    "max_seq_length": { "type": "integer", "minimum": 16, "default": 288 },
    "max_train_samples": { "type": "integer", "minimum": 10, "default": 5000 },
    "rounds": { "type": "integer", "minimum": 1, "default": 5 },
    "fp16": { "type": "boolean", "default": false },
    "bf16": { "type": "boolean", "default": false },
    "shuffle": { "type": "boolean", "default": true }
  },
  "additionalProperties": true
}
